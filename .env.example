# Copy to .env. Everything here is optional: the app runs with no configuration at all.

# With a key, Claude reads the invoice fields. Without one, the built-in parser does.
# Either way the decision is made by the same deterministic rules.
# ANTHROPIC_API_KEY=

# Model used for extraction when a key is present.
# INVOICE_DESK_MODEL=claude-opus-5-5

# Force the built-in parser even when a key is present.
# INVOICE_DESK_AI=off

# Where the SQLite database, uploads and page previews are kept.
# INVOICE_DESK_DATA=./data
